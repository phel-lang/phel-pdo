(in-ns phel.pdo)

(defstruct statement [stmt])

(defn- stmt-handle
  "The raw \\PDOStatement behind a statement struct, for the statement-only wrappers."
  [stmt]
  (if (statement? stmt)
    (stmt :stmt)
    (bad-handle stmt "a statement handle")))

(defn- row->map [row]
  (into {} (for [[k v] :pairs (php->phel row)] [(keyword k) v])))

(defn- column-keywords
  "Keyword vector for the statement's result-set columns, in ordinal order, or nil
  when the driver cannot report column metadata (getColumnMeta is optional and some
  ODBC/dblib setups omit it). Column names are constant for a result set, so this is
  computed once and reused for every row instead of re-keywording each cell."
  [stmt]
  (let [s (stmt-handle stmt)]
    (try
      (into [] (for [i :range [0 (php/-> s (columnCount))]]
                 (keyword (php/aget (php/-> s (getColumnMeta i)) "name"))))
      (catch \Throwable _e nil))))

(defn- num-row->map
  "Shapes one FETCH_NUM row against the pre-computed column keywords. php->phel
  already yields a vector for a PHP list, so it is zipped directly - routing it
  through `values` first rebuilds the sequence and costs more than the zip."
  [ks row]
  (zipmap ks (php->phel row)))

(defn fetch
  "Fetches the next row from a result set, or nil if no more rows"
  [stmt]
  (when-let [row (php/-> (stmt-handle stmt) (fetch \PDO/FETCH_ASSOC))]
    (row->map row)))

(defn fetch-column
  "Returns a single 0-indexed column from the next row of a result set, or not-found
  (nil by default) once the cursor is exhausted. A SQL NULL column reads back as nil,
  so pass a distinct not-found value when you need to tell the two apart"
  [stmt & [column not-found]]
  (let [row (php/-> (stmt-handle stmt) (fetch \PDO/FETCH_NUM))
        idx (or column 0)]
    (cond
      ;; PDO signals an exhausted cursor with false; a row is always an array,
      ;; so this stays unambiguous even for a column holding a real false.
      (php/=== row false) not-found
      (php/array_key_exists idx row) (php->phel (php/aget row idx))
      (throw (php/new \InvalidArgumentException
                      (str "fetch-column: column index " idx " out of range, row has "
                           (php/count row) " column(s)"))))))

(defn fetch-all
  "Fetches the remaining rows from a result set as a seq of maps"
  [stmt]
  (if-let [ks (column-keywords stmt)]
    (map (partial num-row->map ks)
         (or (php/-> (stmt-handle stmt) (fetchAll \PDO/FETCH_NUM)) []))
    (map row->map (or (php/-> (stmt-handle stmt) (fetchAll \PDO/FETCH_ASSOC)) []))))

(defn- num-row-seq [stmt ks]
  (lazy-seq
   (when-let [row (php/-> (stmt-handle stmt) (fetch \PDO/FETCH_NUM))]
     (cons (num-row->map ks row) (num-row-seq stmt ks)))))

(defn- assoc-row-seq [stmt]
  (lazy-seq
   (when-let [row (fetch stmt)]
     (cons row (assoc-row-seq stmt)))))

(defn statement-seq
  "Returns a lazy seq of the statement's remaining rows as maps, fetched one at a
  time. The cursor stays open until the seq is fully consumed; on drivers with
  cursor limits, realise it fully or call close-cursor when done early"
  [stmt]
  (if-let [ks (column-keywords stmt)]
    (num-row-seq stmt ks)
    (assoc-row-seq stmt)))

(defn fetch-object
  "Fetches the next row as an object (stdClass by default, or an instance of class-name), or nil if no more rows"
  [stmt & [class-name ctor-args]]
  (when-let [obj (php/-> (stmt-handle stmt)
                         (fetchObject (or class-name "stdClass")
                                      (phel->php (or ctor-args []))))]
    obj))

(declare bind-value)

(defn execute
  "Executes a prepared statement. Params are bound individually so they pick up the
  type inference of bind-value - passing them to PDOStatement::execute would force
  every one to PARAM_STR. A map binds by name, anything else binds positionally
  (1-based, in order)"
  [stmt & [params]]
  (when-not (empty? params)
    (if (map? params)
      (dofor [[k v] :pairs params] (bind-value stmt k v))
      (dofor [[i v] :pairs params] (bind-value stmt (inc i) v))))
  (php/-> (stmt-handle stmt) (execute))
  stmt)

(defn close-cursor
  "Closes the cursor, enabling the statement to be executed again"
  [stmt]
  (php/-> (stmt-handle stmt) (closeCursor))
  stmt)

(defn ^bool next-rowset
  "Advances to the next rowset of a multi-rowset statement; true when another
  rowset is available, false when none remain. Throws PDOException on drivers
  that don't support multiple rowsets (e.g. SQLite)"
  [stmt]
  (php/-> (stmt-handle stmt) (nextRowset)))

(defn set-fetch-mode
  "Sets the default fetch mode for the statement. Extra args match the mode
  (e.g. column index for FETCH_COLUMN, class name + ctor args for FETCH_CLASS).
  Note: fetch / fetch-all always request FETCH_ASSOC, so this default applies to
  the statement's native iteration, not those wrappers"
  [stmt mode & args]
  (let [s (stmt-handle stmt)]
    (case (count args)
      0 (php/-> s (setFetchMode mode))
      1 (php/-> s (setFetchMode mode (phel->php (first args))))
      2 (php/-> s (setFetchMode mode (phel->php (first args)) (phel->php (second args))))
      (throw (php/new \InvalidArgumentException
                      (str "set-fetch-mode accepts at most 2 extra args, got " (count args))))))
  stmt)

(defn ^int column-count
  "Returns the number of columns in the result set"
  [stmt]
  (php/-> (stmt-handle stmt) (columnCount)))

(defn ^int row-count
  "Returns the number of rows affected by the last SQL statement"
  [stmt]
  (php/-> (stmt-handle stmt) (rowCount)))

(defn column-meta
  "Returns metadata for a 0-indexed column in the result set as a map, or nil if unavailable"
  [stmt column]
  (when-let [meta (php/-> (stmt-handle stmt) (getColumnMeta column))]
    (row->map meta)))

(defn- param-key
  "PDO parameter identifier: an integer is a 1-based positional index (kept as-is);
  anything else is a named placeholder coerced to a string."
  [column]
  (if (int? column) column (str column)))

(defn- infer-param-type
  "PDO type for a Phel value. Floats stay PARAM_STR: PDO has no PARAM_FLOAT, and
  PARAM_STR is the lossless choice for them."
  [value]
  (cond
    (nil? value) \PDO/PARAM_NULL
    (boolean? value) \PDO/PARAM_BOOL
    (int? value) \PDO/PARAM_INT
    \PDO/PARAM_STR))

(defn bind-value
  "Binds a value to a parameter (named placeholder or 1-based positional index).
  The PDO type is inferred from the value - nil, booleans and ints get PARAM_NULL,
  PARAM_BOOL and PARAM_INT - unless an explicit type is given"
  [stmt column value & [type]]
  (php/-> (stmt-handle stmt)
          (bindValue (param-key column) value (or type (infer-param-type value))))
  stmt)

(defn bind-param
  "Binds a value to a parameter, with the same type inference as bind-value. The
  value is captured at call time: Phel values are immutable, so unlike PHP's
  by-reference bindParam there is nothing to mutate before execute - for fresh
  values per run, re-bind or pass a params map to execute"
  [stmt column value & [type]]
  (php/-> (stmt-handle stmt)
          (bindParam (param-key column) value (or type (infer-param-type value))))
  stmt)

(defn ^string debug-dump-params
  "Returns an SQL prepared command"
  [stmt]
  (php/ob_start)
  (php/-> (stmt-handle stmt) (debugDumpParams))
  (php/ob_get_clean))

