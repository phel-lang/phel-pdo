(ns phel.pdo)

(defstruct connection [pdo owned state])

(declare statement?)

(defn- bad-handle
  "Raises a caller-facing error for a value that is not the expected phel-pdo handle."
  [handle expected]
  (throw (php/new \InvalidArgumentException
                  (str "phel.pdo: expected " expected ", got " (php/get_debug_type handle)
                       (if (php/instanceof handle \PDO)
                         " - wrap it first with (pdo/from-connection pdo)"
                         "")))))

(defn- handle-target
  "The raw PDO handle behind a connection or statement struct."
  [handle]
  (cond
    (statement? handle) (handle :stmt)
    (connection? handle) (handle :pdo)
    (bad-handle handle "a connection or statement handle")))

(defn ^bool closed?
  "True once close has been called on this connection"
  [conn]
  (and (connection? conn)
       (get (deref (conn :state)) :closed false)))

(defn- conn-pdo
  "The raw \\PDO behind a connection struct, for the connection-only wrappers."
  [conn]
  (cond
    (not (connection? conn)) (bad-handle conn "a connection handle")
    (closed? conn) (throw (php/new \InvalidArgumentException
                                   "phel.pdo: connection is closed"))
    (conn :pdo)))

(defn- options->php
  "Builds a PHP array from a Phel options map. Unlike phel->php it preserves
  integer keys, which PDO attribute maps use (e.g. \\PDO/ATTR_TIMEOUT)."
  [options]
  (apply php-associative-array
         (mapcat (fn [[k v]] [k (phel->php v)]) options)))

(defn ^bool set-attribute
  "Set an attribute on a connection or statement"
  [handle attribute value]
  (php/-> (handle-target handle) (setAttribute attribute value)))

(defn get-attribute
  "Retrieve an attribute from a connection or statement"
  [handle attribute]
  (php/-> (handle-target handle) (getAttribute attribute)))

(defn connect
  "Connect database and return connection object.
  Throws a PDOException if the attempt to connect to the requested database fails."
  [dsn & [username password options]]
  (let [conn (connection (php/new \PDO dsn username password (options->php (or options {})))
                         true
                         (atom {:closed false}))]
    (set-attribute conn \PDO/ATTR_ERRMODE \PDO/ERRMODE_EXCEPTION)
    conn))

(defn from-connection
  "Wraps an already-open \\PDO instance in a connection, reusing it as-is.
  The host owns the connection's configuration and lifecycle; phel-pdo never
  closes a connection it did not open. Pass {:apply-defaults true} to set
  phel-pdo's ERRMODE_EXCEPTION default on the wrapped handle."
  [pdo & [options]]
  (when-not (php/instanceof pdo \PDO)
    (throw (php/new \InvalidArgumentException "from-connection expects a \\PDO instance")))
  (let [conn (connection pdo false (atom {:closed false}))]
    (when (get options :apply-defaults)
      (set-attribute conn \PDO/ATTR_ERRMODE \PDO/ERRMODE_EXCEPTION))
    conn))

(defn ^int exec
  "Execute an SQL statement and return the number of affected rows"
  [conn stmt]
  (php/-> (conn-pdo conn) (exec stmt)))

(declare statement)
(declare execute)

(defn prepare
  "Prepares a statement for execution and returns a statement object"
  [conn stmt & [options]]
  (statement
   (php/-> (conn-pdo conn) (prepare stmt (options->php (or options {})))) {}))

(declare set-fetch-mode)

(defn query
  "Prepares and executes SQL and returns a statement. With params it goes through a
  prepared statement - a map binds by name, a vector positionally - so values are
  bound, never interpolated. Without params it uses PDO::query directly.
  Options: {:fetch-mode \\PDO/FETCH_...} sets the statement's native fetch mode"
  [conn sql & [params options]]
  (if (empty? params)
    (statement
     (php/-> (conn-pdo conn) (query sql (get options :fetch-mode \PDO/FETCH_ASSOC))) {})
    (let [stmt (prepare conn sql)]
      (when-let [mode (get options :fetch-mode)]
        (set-fetch-mode stmt mode))
      (execute stmt params))))

(defn ^bool begin
  "Initiates a transaction"
  [conn]
  (php/-> (conn-pdo conn) (beginTransaction)))

(defn ^bool rollback
  "Rolls back a transaction"
  [conn]
  (php/-> (conn-pdo conn) (rollback)))

(defn ^bool commit
  "Commits a transaction"
  [conn]
  (php/-> (conn-pdo conn) (commit)))

(defn ^string quote
  "Quotes a string for use in a query"
  [conn string & [type]]
  (php/-> (conn-pdo conn) (quote string (or type \PDO/PARAM_STR))))

(defn ^string last-insert-id
  "Returns the ID of the last inserted row or sequence value, as a string (as PDO
  reports it). Returning the raw string is lossless for big integers and named
  sequences; coerce with php/intval at the call site when you need a number"
  [conn]
  (php/-> (conn-pdo conn) (lastInsertId)))

(defn- check-ident [s]
  (if (= 1 (php/preg_match "/^[A-Za-z_][A-Za-z0-9_]*$/" s))
    s
    (throw (php/new \InvalidArgumentException (str "Invalid identifier: " s)))))

(defn- join-csv [xs]
  (php/implode ", " (phel->php (into [] xs))))

;;; ---------------------------------------------------------------------------
;;; Statement reuse for the map builders
;;;
;;; insert / update / delete / insert-many build one SQL string per (table,
;;; column-set) and throw the statement away, so a loop re-prepares the same SQL
;;; every iteration. Measured cost of a prepare, 2000 iterations:
;;;
;;;   pgsql   0.295 ms each   (3.2x slower over the loop)
;;;   mysql   0.027 ms each   (1.2x)
;;;   sqlite  0.023 ms each   (3.2x)
;;;
;;; The cache is deliberately private and used only by the builders, which own
;;; their statement end to end - prepared, executed, read, discarded, never handed
;;; to the caller. A cache behind the public `prepare` could hand the same
;;; statement to two live call sites, where the second execute would silently
;;; invalidate the first one's cursor. That cannot be prevented by an opt-in flag,
;;; so it is not offered.

(declare close-cursor)

(def- statement-cache-limit 32)

(defn- cached-prepare
  "Prepared statement for sql, reused across calls on this connection. Only safe
  for callers that own the statement for the whole of its life."
  [conn sql]
  (let [st    (deref (conn :state))
        cache (or (get st :stmt-cache) {})
        order (or (get st :stmt-order) [])]
    (if-let [stmt (get cache sql)]
      ;; A reused statement may still hold the previous execute's cursor.
      (close-cursor stmt)
      (let [stmt  (prepare conn sql)
            evict (when (>= (count order) statement-cache-limit) (first order))
            cache (-> (if evict (dissoc cache evict) cache) (put sql stmt))
            order (-> (if evict (into [] (rest order)) order) (push sql))]
        (swap! (conn :state) (fn [s] (-> s (put :stmt-cache cache) (put :stmt-order order))))
        stmt))))

(defn ^string insert
  "Inserts a row built from a map into table and returns the new last-insert-id
  (a string, as PDO reports it). Table and column names must be plain identifiers;
  values are bound as parameters."
  [conn table row]
  (when (empty? row)
    (throw (php/new \InvalidArgumentException "insert row map must not be empty")))
  (let [tbl  (check-ident (name table))
        cols (into [] (for [k :in (keys row)] (check-ident (name k))))
        sql  (str "INSERT INTO " tbl
                  " (" (join-csv cols) ")"
                  " VALUES (" (join-csv (for [c :in cols] (str ":" c))) ")")]
    (-> (cached-prepare conn sql) (execute row))
    (last-insert-id conn)))

(declare fetch)
(declare fetch-all)
(declare fetch-column)

(defn select
  "Runs SQL with params and returns every row. Shapes through fetch-all, so options
  takes the same :as - :maps (default) gives a vector of maps, :rows gives
  {:cols [...] :rows [[...]]}. Releases the cursor before returning"
  [conn sql & [params options]]
  (let [stmt (query conn sql params)
        rows (fetch-all stmt options)
        rows (if (map? rows) rows (into [] rows))]
    (close-cursor stmt)
    rows))

(defn select-one
  "Runs SQL with params and returns the first row as a map, or nil when there are
  none. Releases the cursor before returning - it does not append a LIMIT, since
  rewriting the caller's SQL is not this wrapper's job"
  [conn sql & [params]]
  (let [stmt (query conn sql params)
        row  (fetch stmt)]
    (close-cursor stmt)
    row))

(defn select-value
  "Runs SQL with params and returns the first column of the first row - the shape of
  a count/max/exists check. Returns not-found (nil by default) when there are no
  rows; a SQL NULL column is nil either way. Releases the cursor before returning"
  [conn sql & [params not-found]]
  (let [stmt  (query conn sql params)
        value (fetch-column stmt 0 not-found)]
    (close-cursor stmt)
    value))

;;; ---------------------------------------------------------------------------
;;; IN (...) expansion
;;;
;;; PDO binds one placeholder to one scalar, so a variable-length list cannot be
;;; bound directly: `where id in (?)` with [1 2 3] matches nothing rather than
;;; erroring. The caller has to generate N placeholders and flatten the params to
;;; match, which means concatenating SQL - exactly what this library exists to
;;; avoid. expand-in does it once, correctly.
;;;
;;; The scanner is the whole job. A `?` or `:name` inside a string literal, a
;;; quoted identifier or a comment is data, and a `::` is a Postgres cast. Treat
;;; any of them as a placeholder and every later binding silently shifts by one.

(defn- char-at [s i]
  (php/substr s i 1))

(defn- skip-delimited
  "Index just past a run opened at i by open and closed by close. A doubled
  delimiter ('' inside a literal) escapes rather than closes."
  [sql i open close]
  (let [len (php/strlen sql)]
    (loop [j (inc i)]
      (cond
        (>= j len) len
        (and (= close (char-at sql j))
             (= close (char-at sql (inc j)))) (recur (+ j 2))
        (= close (char-at sql j)) (inc j)
        (recur (inc j))))))

(defn- skip-to
  "Index just past the next occurrence of marker, or the end of sql."
  [sql i marker]
  (let [at (php/strpos sql marker i)]
    (if (php/=== at false) (php/strlen sql) (+ at (php/strlen marker)))))

(defn- ident-char? [c]
  (= 1 (php/preg_match "/^[A-Za-z0-9_]$/" c)))

(defn- read-ident
  "Index just past the identifier starting at i."
  [sql i]
  (let [len (php/strlen sql)]
    (loop [j i]
      (if (and (< j len) (ident-char? (char-at sql j)))
        (recur (inc j))
        j))))

(defn- expansion
  "Placeholder text for one param, and the values it contributes."
  [named-key value]
  (cond
    (not (vector? value))
    [(if named-key (str ":" named-key) "?") [[named-key value]]]

    (empty? value)
    (throw (php/new \InvalidArgumentException
                    (str "expand-in: cannot expand an empty list"
                         (if named-key (str " for :" named-key) "")
                         " - `IN ()` is not valid SQL")))

    named-key
    [(php/implode ", " (phel->php (into [] (for [i :range [0 (count value)]]
                                             (str ":" named-key "_" i)))))
     (into [] (for [i :range [0 (count value)]]
                [(str named-key "_" i) (get value i)]))]

    [(php/implode ", " (phel->php (into [] (for [_ :in value] "?"))))
     (into [] (for [v :in value] [nil v]))]))

(defn expand-in
  "Expands list-valued params into matching placeholder runs and returns
  [sql params] ready for prepare/execute or query.

  A vector param becomes N placeholders in place - `in (?)` with [1 2 3] becomes
  `in (?, ?, ?)` - and its values splice into the flat param list. Scalars pass
  through untouched. Named params expand to :name_0, :name_1, ...

  Placeholders inside string literals, quoted identifiers and comments are left
  alone, as is the Postgres `::` cast. An empty list raises rather than silently
  producing a predicate that matches nothing, and so does a params/placeholder
  count mismatch"
  [sql params]
  (let [named? (map? params)
        len    (php/strlen sql)]
    (loop [i 0, out "", used [], positional 0, names []]
      (if (>= i len)
        ;; `names` counts the placeholders the SQL actually carries; `used`
        ;; counts the values they expanded to, which is a different number.
        (let [seen     (if named? (count (distinct names)) positional)
              expected (count params)]
          (when (not= seen expected)
            (throw (php/new \InvalidArgumentException
                            (str "expand-in: SQL has " seen " placeholder(s) but "
                                 expected " param(s) were given"))))
          [out (if named?
                 (into {} (for [[k v] :in used] [(keyword k) v]))
                 (into [] (for [[_ v] :in used] v)))])
        (let [c (char-at sql i)
              n (char-at sql (inc i))]
          (cond
            ;; literals, quoted identifiers and comments are copied verbatim
            (= c "'") (let [j (skip-delimited sql i "'" "'")]
                        (recur j (str out (php/substr sql i (- j i))) used positional names))
            (= c "\"") (let [j (skip-delimited sql i "\"" "\"")]
                         (recur j (str out (php/substr sql i (- j i))) used positional names))
            (= c "`") (let [j (skip-delimited sql i "`" "`")]
                        (recur j (str out (php/substr sql i (- j i))) used positional names))
            (and (= c "-") (= n "-")) (let [j (skip-to sql i "\n")]
                                        (recur j (str out (php/substr sql i (- j i))) used positional names))
            (and (= c "/") (= n "*")) (let [j (skip-to sql i "*/")]
                                        (recur j (str out (php/substr sql i (- j i))) used positional names))
            ;; Postgres cast, not a placeholder
            (and (= c ":") (= n ":")) (recur (+ i 2) (str out "::") used positional names)

            (and (= c ":") (ident-char? n) named?)
            (let [j  (read-ident sql (inc i))
                  nm (php/substr sql (inc i) (- j (inc i)))
                  k  (keyword nm)]
              (when-not (contains? params k)
                (throw (php/new \InvalidArgumentException
                                (str "expand-in: no param supplied for :" nm))))
              (let [[text vals] (expansion nm (get params k))]
                (recur j (str out text) (into used vals) positional (conj names nm))))

            (and (= c "?") (not named?))
            (do
              (when (>= positional (count params))
                (throw (php/new \InvalidArgumentException
                                (str "expand-in: SQL has more placeholders than the "
                                     (count params) " param(s) given"))))
              (let [[text vals] (expansion nil (get params positional))]
                (recur (inc i) (str out text) (into used vals) (inc positional) names)))

            (recur (inc i) (str out c) used positional names)))))))

(declare row-count)

(defn- ident-names
  "Checked identifier names for a map's keys, in insertion order."
  [m]
  (into [] (for [k :in (keys m)] (check-ident (name k)))))

(defn- prefix-keys
  "Re-keys a map so its placeholders cannot collide with another clause's."
  [prefix m]
  (into {} (for [[k v] :pairs m] [(keyword (str prefix (name k))) v])))

(defn- assignments
  "`col = :prefixcol` for each column, joined with sep."
  [sep prefix cols]
  (php/implode sep (phel->php (into [] (for [c :in cols] (str c " = :" prefix c))))))

(defn- require-non-empty [m what]
  (when (empty? m)
    (throw (php/new \InvalidArgumentException (str what " must not be empty")))))

(defn ^int update
  "Updates table, setting the columns of set-map on the rows matched by where-map,
  and returns the affected row count. Table and column names must be plain
  identifiers; every value is bound as a parameter. Both maps must be non-empty -
  an unqualified UPDATE would rewrite the whole table, which is never what a
  missing where clause meant"
  [conn table set-map where-map]
  (require-non-empty set-map "update set map")
  (require-non-empty where-map "update where map")
  (let [tbl    (check-ident (name table))
        sql    (str "UPDATE " tbl
                    " SET " (assignments ", " "set_" (ident-names set-map))
                    " WHERE " (assignments " AND " "where_" (ident-names where-map)))
        params (merge (prefix-keys "set_" set-map)
                      (prefix-keys "where_" where-map))]
    (-> (cached-prepare conn sql) (execute params) (row-count))))

(defn ^int delete
  "Deletes the rows of table matched by where-map and returns the affected row count.
  where-map must be non-empty - an unqualified DELETE would empty the table"
  [conn table where-map]
  (require-non-empty where-map "delete where map")
  (let [tbl (check-ident (name table))
        sql (str "DELETE FROM " tbl
                 " WHERE " (assignments " AND " "where_" (ident-names where-map)))]
    (-> (cached-prepare conn sql) (execute (prefix-keys "where_" where-map)) (row-count))))

(defn ^int insert-many
  "Inserts rows - a seq of maps that all share one set of keys - into table with a
  single multi-VALUES statement, and returns the affected row count.

  Unlike insert it does not return an id: for a multi-row insert that is
  driver-specific (MySQL reports the first, SQLite the last) and this wrapper will
  not paper over the difference.

  The statement carries rows x columns placeholders, and drivers cap that
  (SQLITE_MAX_VARIABLE_NUMBER, MySQL's max_prepared_stmt_count). Chunk very large
  batches at the call site rather than relying on the driver to cope"
  [conn table rows]
  (let [rows (into [] rows)]
    (require-non-empty rows "insert-many rows")
    (let [ks      (into [] (keys (first rows)))
          cols    (into [] (for [k :in ks] (check-ident (name k))))
          key-set (fn [m] (sort (into [] (for [k :in (keys m)] (name k)))))
          shape   (key-set (first rows))]
      (dofor [r :in rows]
        (when-not (= shape (key-set r))
          (throw (php/new \InvalidArgumentException
                          "insert-many rows must all have the same keys"))))
      (let [holes  (str "(" (join-csv (for [_ :in cols] "?")) ")")
            sql    (str "INSERT INTO " (check-ident (name table))
                        " (" (join-csv cols) ")"
                        " VALUES " (join-csv (for [_ :in rows] holes)))
            params (into [] (mapcat (fn [r] (for [k :in ks] (get r k))) rows))]
        (-> (cached-prepare conn sql) (execute params) (row-count))))))

(defn ^string error-code
  "Fetch the SQLSTATE associated with the last operation on a connection or statement.
  SQLSTATE is a 5-character code (e.g. \"23000\", \"HY000\"), returned as a string"
  [handle]
  (php/-> (handle-target handle) (errorCode)))

(defn error-info
  "Fetch extended error information associated with the last operation on a connection
  or statement, as [sqlstate driver-code driver-message]. sqlstate is the SQLSTATE
  string; driver-code is the driver-specific integer"
  [handle]
  (let [[sqlstate driver-code driver-message]
        (values (php->phel (php/-> (handle-target handle) (errorInfo))))]
    [sqlstate (php/intval driver-code) driver-message]))

(defn ^bool in-transaction
  "Checks if inside a transaction"
  [conn]
  (php/-> (conn-pdo conn) (inTransaction)))

;; Monotonic source of savepoint names. Savepoint names are identifiers, so they
;; cannot be bound as parameters - they must be generated here and never taken
;; from caller input. Nested levels need distinct names or ROLLBACK TO would
;; unwind to the wrong one.
(def- savepoint-counter (atom 0))

(defn- next-savepoint-name []
  (str "phel_sp_" (swap! savepoint-counter inc)))

(defn with-savepoint
  "Calls f inside a SAVEPOINT on conn: releases the savepoint and returns f's value,
  or rolls back to it and re-throws. Requires an open transaction and a driver that
  supports SAVEPOINT (SQLite, MySQL/InnoDB and PostgreSQL all do). This is the
  primitive with-transaction uses for its nested case"
  [conn f]
  (let [sp (next-savepoint-name)]
    (exec conn (str "SAVEPOINT " sp))
    (try
      (let [result (f)]
        (exec conn (str "RELEASE SAVEPOINT " sp))
        result)
      (catch \Throwable e
        (exec conn (str "ROLLBACK TO SAVEPOINT " sp))
        (throw e)))))

(defmacro with-transaction
  "Runs body inside a transaction on conn: commits on success and returns the last
  body value, or rolls back and re-throws on error. If conn is already in a
  transaction, body runs inside a SAVEPOINT instead, so a failure that the caller
  catches undoes only this block's writes and leaves the outer transaction intact."
  [conn & body]
  `(let [conn# ~conn]
     (if (in-transaction conn#)
       (with-savepoint conn# (fn [] ~@body))
       (do
         (begin conn#)
         (try
           (let [result# (do ~@body)]
             (commit conn#)
             result#)
           (catch \Throwable e#
             (rollback conn#)
             (throw e#)))))))

(defn close
  "Closes a connection opened by connect: rolls back an open transaction, then
  marks the handle closed so any further use raises instead of reaching PDO.
  Idempotent.

  What this does and does not guarantee: PDO has no close() method, so the
  underlying connection is released when the last reference to the \\PDO object
  goes out of scope. close drops phel-pdo's *use* of it immediately and
  deterministically; the socket goes when the struct does. with-connection scopes
  the struct so that happens promptly.

  A connection wrapped with from-connection belongs to the host: close marks the
  phel-pdo wrapper unusable but never rolls back or disturbs the host's \\PDO"
  [conn]
  (when-not (connection? conn)
    (bad-handle conn "a connection handle"))
  (when-not (closed? conn)
    (when (and (conn :owned) (php/-> (conn :pdo) (inTransaction)))
      (php/-> (conn :pdo) (rollback)))
    (swap! (conn :state) (fn [s] (-> s (put :closed true)
                                     (put :stmt-cache {})
                                     (put :stmt-order [])))))
  conn)

(defmacro with-connection
  "Binds name to conn for the duration of body and closes it afterwards, on a
  normal return and on a throw alike. Returns the last body value"
  [bindings & body]
  (let [name (first bindings)
        init (second bindings)]
    `(let [~name ~init]
       (try
         (do ~@body)
         (finally (close ~name))))))

(defn get-available-drivers
  "Return a vector of available PDO driver names. PDO::getAvailableDrivers is
  static, so no connection is needed"
  []
  (values (php->phel (php/:: \PDO (getAvailableDrivers)))))

(load "pdo/statement")
