(ns phel.pdo)

(defstruct connection [pdo])

(declare statement?)

(defn- bad-handle
  "Raises a caller-facing error for a value that is not the expected phel-pdo handle."
  [handle expected]
  (throw (php/new \InvalidArgumentException
                  (str "phel.pdo: expected " expected ", got " (php/get_debug_type handle)
                       (if (php/instanceof handle \PDO)
                         " - wrap it first with (pdo/from-connection pdo)"
                         "")))))

(defn- handle-target
  "The raw PDO handle behind a connection or statement struct."
  [handle]
  (cond
    (statement? handle) (handle :stmt)
    (connection? handle) (handle :pdo)
    (bad-handle handle "a connection or statement handle")))

(defn- conn-pdo
  "The raw \\PDO behind a connection struct, for the connection-only wrappers."
  [conn]
  (if (connection? conn)
    (conn :pdo)
    (bad-handle conn "a connection handle")))

(defn- options->php
  "Builds a PHP array from a Phel options map. Unlike phel->php it preserves
  integer keys, which PDO attribute maps use (e.g. \\PDO/ATTR_TIMEOUT)."
  [options]
  (apply php-associative-array
         (mapcat (fn [[k v]] [k (phel->php v)]) options)))

(defn ^bool set-attribute
  "Set an attribute on a connection or statement"
  [handle attribute value]
  (php/-> (handle-target handle) (setAttribute attribute value)))

(defn get-attribute
  "Retrieve an attribute from a connection or statement"
  [handle attribute]
  (php/-> (handle-target handle) (getAttribute attribute)))

(defn connect
  "Connect database and return connection object.
  Throws a PDOException if the attempt to connect to the requested database fails."
  [dsn & [username password options]]
  (let [conn (connection (php/new \PDO dsn username password (options->php (or options {}))))]
    (set-attribute conn \PDO/ATTR_ERRMODE \PDO/ERRMODE_EXCEPTION)
    conn))

(defn from-connection
  "Wraps an already-open \\PDO instance in a connection, reusing it as-is.
  The host owns the connection's configuration and lifecycle; phel-pdo never
  closes a connection it did not open. Pass {:apply-defaults true} to set
  phel-pdo's ERRMODE_EXCEPTION default on the wrapped handle."
  [pdo & [options]]
  (when-not (php/instanceof pdo \PDO)
    (throw (php/new \InvalidArgumentException "from-connection expects a \\PDO instance")))
  (let [conn (connection pdo)]
    (when (get options :apply-defaults)
      (set-attribute conn \PDO/ATTR_ERRMODE \PDO/ERRMODE_EXCEPTION))
    conn))

(defn ^int exec
  "Execute an SQL statement and return the number of affected rows"
  [conn stmt]
  (php/-> (conn-pdo conn) (exec stmt)))

(declare statement)
(declare execute)

(defn prepare
  "Prepares a statement for execution and returns a statement object"
  [conn stmt & [options]]
  (statement
   (php/-> (conn-pdo conn) (prepare stmt (options->php (or options {}))))))

(declare set-fetch-mode)

(defn query
  "Prepares and executes SQL and returns a statement. With params it goes through a
  prepared statement - a map binds by name, a vector positionally - so values are
  bound, never interpolated. Without params it uses PDO::query directly.
  Options: {:fetch-mode \\PDO/FETCH_...} sets the statement's native fetch mode"
  [conn sql & [params options]]
  (if (empty? params)
    (statement
     (php/-> (conn-pdo conn) (query sql (get options :fetch-mode \PDO/FETCH_ASSOC))))
    (let [stmt (prepare conn sql)]
      (when-let [mode (get options :fetch-mode)]
        (set-fetch-mode stmt mode))
      (execute stmt params))))

(defn ^bool begin
  "Initiates a transaction"
  [conn]
  (php/-> (conn-pdo conn) (beginTransaction)))

(defn ^bool rollback
  "Rolls back a transaction"
  [conn]
  (php/-> (conn-pdo conn) (rollback)))

(defn ^bool commit
  "Commits a transaction"
  [conn]
  (php/-> (conn-pdo conn) (commit)))

(defn ^string quote
  "Quotes a string for use in a query"
  [conn string & [type]]
  (php/-> (conn-pdo conn) (quote string (or type \PDO/PARAM_STR))))

(defn ^string last-insert-id
  "Returns the ID of the last inserted row or sequence value, as a string (as PDO
  reports it). Returning the raw string is lossless for big integers and named
  sequences; coerce with php/intval at the call site when you need a number"
  [conn]
  (php/-> (conn-pdo conn) (lastInsertId)))

(defn- check-ident [s]
  (if (= 1 (php/preg_match "/^[A-Za-z_][A-Za-z0-9_]*$/" s))
    s
    (throw (php/new \InvalidArgumentException (str "Invalid identifier: " s)))))

(defn- join-csv [xs]
  (php/implode ", " (phel->php (into [] xs))))

(defn ^string insert
  "Inserts a row built from a map into table and returns the new last-insert-id
  (a string, as PDO reports it). Table and column names must be plain identifiers;
  values are bound as parameters."
  [conn table row]
  (when (empty? row)
    (throw (php/new \InvalidArgumentException "insert row map must not be empty")))
  (let [tbl  (check-ident (name table))
        cols (into [] (for [k :in (keys row)] (check-ident (name k))))
        sql  (str "INSERT INTO " tbl
                  " (" (join-csv cols) ")"
                  " VALUES (" (join-csv (for [c :in cols] (str ":" c))) ")")]
    (-> (prepare conn sql) (execute row))
    (last-insert-id conn)))

(declare fetch)
(declare fetch-all)
(declare fetch-column)
(declare close-cursor)

(defn select
  "Runs SQL with params and returns every row. Shapes through fetch-all, so options
  takes the same :as - :maps (default) gives a vector of maps, :rows gives
  {:cols [...] :rows [[...]]}. Releases the cursor before returning"
  [conn sql & [params options]]
  (let [stmt (query conn sql params)
        rows (fetch-all stmt options)
        rows (if (map? rows) rows (into [] rows))]
    (close-cursor stmt)
    rows))

(defn select-one
  "Runs SQL with params and returns the first row as a map, or nil when there are
  none. Releases the cursor before returning - it does not append a LIMIT, since
  rewriting the caller's SQL is not this wrapper's job"
  [conn sql & [params]]
  (let [stmt (query conn sql params)
        row  (fetch stmt)]
    (close-cursor stmt)
    row))

(defn select-value
  "Runs SQL with params and returns the first column of the first row - the shape of
  a count/max/exists check. Returns not-found (nil by default) when there are no
  rows; a SQL NULL column is nil either way. Releases the cursor before returning"
  [conn sql & [params not-found]]
  (let [stmt  (query conn sql params)
        value (fetch-column stmt 0 not-found)]
    (close-cursor stmt)
    value))

(defn ^string error-code
  "Fetch the SQLSTATE associated with the last operation on a connection or statement.
  SQLSTATE is a 5-character code (e.g. \"23000\", \"HY000\"), returned as a string"
  [handle]
  (php/-> (handle-target handle) (errorCode)))

(defn error-info
  "Fetch extended error information associated with the last operation on a connection
  or statement, as [sqlstate driver-code driver-message]. sqlstate is the SQLSTATE
  string; driver-code is the driver-specific integer"
  [handle]
  (let [[sqlstate driver-code driver-message]
        (values (php->phel (php/-> (handle-target handle) (errorInfo))))]
    [sqlstate (php/intval driver-code) driver-message]))

(defn ^bool in-transaction
  "Checks if inside a transaction"
  [conn]
  (php/-> (conn-pdo conn) (inTransaction)))

;; Monotonic source of savepoint names. Savepoint names are identifiers, so they
;; cannot be bound as parameters - they must be generated here and never taken
;; from caller input. Nested levels need distinct names or ROLLBACK TO would
;; unwind to the wrong one.
(def- savepoint-counter (atom 0))

(defn- next-savepoint-name []
  (str "phel_sp_" (swap! savepoint-counter inc)))

(defn with-savepoint
  "Calls f inside a SAVEPOINT on conn: releases the savepoint and returns f's value,
  or rolls back to it and re-throws. Requires an open transaction and a driver that
  supports SAVEPOINT (SQLite, MySQL/InnoDB and PostgreSQL all do). This is the
  primitive with-transaction uses for its nested case"
  [conn f]
  (let [sp (next-savepoint-name)]
    (exec conn (str "SAVEPOINT " sp))
    (try
      (let [result (f)]
        (exec conn (str "RELEASE SAVEPOINT " sp))
        result)
      (catch \Throwable e
        (exec conn (str "ROLLBACK TO SAVEPOINT " sp))
        (throw e)))))

(defmacro with-transaction
  "Runs body inside a transaction on conn: commits on success and returns the last
  body value, or rolls back and re-throws on error. If conn is already in a
  transaction, body runs inside a SAVEPOINT instead, so a failure that the caller
  catches undoes only this block's writes and leaves the outer transaction intact."
  [conn & body]
  `(let [conn# ~conn]
     (if (in-transaction conn#)
       (with-savepoint conn# (fn [] ~@body))
       (do
         (begin conn#)
         (try
           (let [result# (do ~@body)]
             (commit conn#)
             result#)
           (catch \Throwable e#
             (rollback conn#)
             (throw e#)))))))

(defn get-available-drivers
  "Return a vector of available PDO driver names. PDO::getAvailableDrivers is
  static, so no connection is needed"
  []
  (values (php->phel (php/:: \PDO (getAvailableDrivers)))))

(load "pdo/statement")
