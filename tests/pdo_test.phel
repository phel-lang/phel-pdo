(ns phel.pdo-test
  (:require phel.test :refer [deftest is testing use-fixtures])
  (:require phel.pdo))

;; -------------
;; Test fixtures
;; -------------

(def ^:dynamic *conn* nil)

(defn- fresh-conn []
  (pdo/connect "sqlite::memory:"))

(defn- create-t1 [conn]
  (pdo/exec conn "create table t1 (id integer primary key autoincrement, name varchar(10))"))

(defn- insert-name [conn name]
  (-> (pdo/prepare conn "insert into t1 (name) values (:name)")
      (pdo/execute {:name name})
      (pdo/row-count)))

(defn- seed-t1
  "Create t1 with one row named 'phel'."
  [conn]
  (create-t1 conn)
  (insert-name conn "phel")
  conn)

(defn db-fixture [t]
  (binding [*conn* (fresh-conn)]
    (t)))

(use-fixtures :each db-fixture)

;; ----------
;; Connection
;; ----------

(deftest connect-returns-struct
  (is (struct? *conn*)))

(deftest attribute-roundtrip
  (pdo/set-attribute *conn* \PDO/ATTR_ERRMODE \PDO/ERRMODE_SILENT)
  (is (= \PDO/ERRMODE_SILENT (pdo/get-attribute *conn* \PDO/ATTR_ERRMODE))))

(deftest connect-accepts-options-map
  ;; options must be converted from a Phel map to a PHP array
  (let [conn (pdo/connect "sqlite::memory:" nil nil {\PDO/ATTR_TIMEOUT 5})]
    (is (struct? conn))
    (pdo/exec conn "create table t1 (id integer)")
    (is (= 1 (pdo/exec conn "insert into t1 values (1)")))))

(deftest from-connection-wraps-existing-pdo
  (let [raw  (php/new \PDO "sqlite::memory:")
        conn (pdo/from-connection raw)]
    (pdo/exec conn "create table t1 (id integer primary key autoincrement, name varchar(10))")
    (pdo/exec conn "insert into t1 (name) values ('phel')")
    (is (= {:id 1, :name "phel"} (pdo/fetch (pdo/query conn "select * from t1 where id = 1"))))))

(deftest from-connection-supports-transactions
  (let [raw  (php/new \PDO "sqlite::memory:")
        conn (pdo/from-connection raw)]
    (pdo/exec conn "create table t1 (id integer, name varchar(10))")
    (pdo/with-transaction conn
                          (pdo/exec conn "insert into t1 values (1, 'phel')"))
    (is (= 1 (pdo/fetch-column (pdo/query conn "select count(*) from t1"))))))

(deftest from-connection-leaves-attributes-untouched-by-default
  (let [raw (php/new \PDO "sqlite::memory:")]
    (php/-> raw (setAttribute \PDO/ATTR_ERRMODE \PDO/ERRMODE_SILENT))
    (let [conn (pdo/from-connection raw)]
      (is (= \PDO/ERRMODE_SILENT (pdo/get-attribute conn \PDO/ATTR_ERRMODE))))))

(deftest from-connection-apply-defaults-sets-errmode-exception
  (let [raw (php/new \PDO "sqlite::memory:")]
    (php/-> raw (setAttribute \PDO/ATTR_ERRMODE \PDO/ERRMODE_SILENT))
    (let [conn (pdo/from-connection raw {:apply-defaults true})]
      (is (= \PDO/ERRMODE_EXCEPTION (pdo/get-attribute conn \PDO/ATTR_ERRMODE))))))

(deftest available-drivers-includes-sqlite
  (is (contains-value? (pdo/get-available-drivers) "sqlite")))

(deftest quote-escapes-single-quotes
  (is (= "'I''m fine.'" (pdo/quote *conn* "I'm fine."))))

;; -----------------
;; Handle validation
;; -----------------

(defn- caught
  "The exception f throws, or nil when it returns normally."
  [f]
  (try
    (do (f) nil)
    (catch \Throwable e e)))

(defn- caught-class [f]
  (when-let [e (caught f)] (php/get_class e)))

(defn- caught-message [f]
  (when-let [e (caught f)] (php/-> e (getMessage))))

(deftest dual-handle-fns-reject-non-handle
  (testing "a plain map is not a connection or statement"
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/get-attribute {:foo 1} \PDO/ATTR_ERRMODE)))))
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/set-attribute {:foo 1} \PDO/ATTR_ERRMODE 0)))))
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/error-code {:foo 1})))))
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/error-info {:foo 1})))))))

(deftest dual-handle-fns-reject-raw-pdo-with-hint
  (let [raw (php/new \PDO "sqlite::memory:")]
    (is (= "InvalidArgumentException"
           (caught-class (fn [] (pdo/error-code raw)))))
    (is (php/str_contains (caught-message (fn [] (pdo/error-code raw))) "from-connection")
        "the message should point at from-connection")))

(deftest connection-fns-reject-statement-handle
  (let [stmt (pdo/query *conn* "select 1")]
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/begin stmt)))))
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/exec stmt "select 1")))))
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/last-insert-id stmt)))))
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/prepare stmt "select 1")))))))

(deftest statement-fns-reject-connection-handle
  (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/fetch *conn*)))))
  (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/execute *conn*)))))
  (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/row-count *conn*))))))

(deftest valid-handles-still-work
  (testing "the guards do not disturb the happy path"
           (is (= "00000" (pdo/error-code *conn*)))
           (is (= "00000" (pdo/error-code (pdo/query *conn* "select 1"))))))

;; ----
;; Exec
;; ----

(deftest exec-create-returns-zero
  (is (= 0 (create-t1 *conn*))))

(deftest exec-insert-returns-affected-rows
  (create-t1 *conn*)
  (is (= 1 (insert-name *conn* "phel"))))

(deftest last-insert-id-reflects-last-row
  (seed-t1 *conn*)
  (is (= "1" (pdo/last-insert-id *conn*))))

;; ------------
;; Transactions
;; ------------

(deftest in-transaction-tracks-state
  (testing "false outside transaction"
           (is (= false (pdo/in-transaction *conn*))))
  (testing "true after begin"
           (pdo/begin *conn*)
           (is (= true (pdo/in-transaction *conn*))))
  (testing "false after commit"
           (pdo/commit *conn*)
           (is (= false (pdo/in-transaction *conn*)))))

(deftest commit-persists-changes
  (create-t1 *conn*)
  (pdo/begin *conn*)
  (insert-name *conn* "phel")
  (pdo/commit *conn*)
  (is (= 1 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1")))))

(deftest rollback-reverts-changes
  (create-t1 *conn*)
  (pdo/begin *conn*)
  (insert-name *conn* "phel")
  (pdo/rollback *conn*)
  (is (= 0 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1")))))

(deftest with-transaction-commits-and-returns-last-value
  (create-t1 *conn*)
  (let [ret (pdo/with-transaction *conn*
                                  (insert-name *conn* "phel")
                                  :done)]
    (is (= :done ret))
    (is (= 1 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1"))))))

(deftest with-transaction-rolls-back-and-rethrows-on-error
  (create-t1 *conn*)
  (let [threw (try
                (pdo/with-transaction *conn*
                                      (insert-name *conn* "phel")
                                      (throw (php/new \Exception "boom")))
                false
                (catch \Exception _e true))]
    (is (= true threw))
    (is (= 0 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1"))))))

(deftest with-transaction-nested-runs-inline
  (create-t1 *conn*)
  (pdo/begin *conn*)
  ;; already in a transaction: the inner call must not begin/commit again
  (pdo/with-transaction *conn*
                        (insert-name *conn* "phel"))
  (testing "inner call left the outer transaction open"
           (is (= true (pdo/in-transaction *conn*))))
  (pdo/rollback *conn*)
  (testing "outer rollback still reverts the inline insert"
           (is (= 0 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1"))))))

(defn- count-t1 [conn]
  (pdo/fetch-column (pdo/query conn "select count(*) from t1")))

(deftest nested-transaction-rolls-back-inner-only
  ;; The inner block throws and the caller swallows it. Only the inner write
  ;; must disappear - the outer transaction still commits its own.
  (create-t1 *conn*)
  (pdo/with-transaction *conn*
                        (insert-name *conn* "outer")
                        (try
                          (pdo/with-transaction *conn*
                                                (insert-name *conn* "inner")
                                                (throw (php/new \Exception "boom")))
                          (catch \Throwable _e :caught)))
  (is (= 1 (count-t1 *conn*)))
  (is (= "outer" (pdo/fetch-column (pdo/query *conn* "select name from t1")))))

(deftest nested-transaction-commits-on-success
  (create-t1 *conn*)
  (let [ret (pdo/with-transaction *conn*
                                  (insert-name *conn* "outer")
                                  (pdo/with-transaction *conn*
                                                        (insert-name *conn* "inner")
                                                        :inner-done))]
    (is (= :inner-done ret))
    (is (= 2 (count-t1 *conn*)))))

(deftest nested-transaction-propagates-uncaught-throw
  (create-t1 *conn*)
  (let [threw (try
                (pdo/with-transaction *conn*
                                      (insert-name *conn* "outer")
                                      (pdo/with-transaction *conn*
                                                            (insert-name *conn* "inner")
                                                            (throw (php/new \Exception "boom"))))
                false
                (catch \Exception _e true))]
    (testing "an uncaught inner throw still rolls the whole outer transaction back"
             (is (= true threw))
             (is (= 0 (count-t1 *conn*)))
             (is (= false (pdo/in-transaction *conn*))))))

(deftest nested-transaction-three-levels-rolls-back-to-correct-level
  (create-t1 *conn*)
  (pdo/with-transaction *conn*
                        (insert-name *conn* "L1")
                        (pdo/with-transaction *conn*
                                              (insert-name *conn* "L2")
                                              (try
                                                (pdo/with-transaction *conn*
                                                                      (insert-name *conn* "L3")
                                                                      (throw (php/new \Exception "boom")))
                                                (catch \Throwable _e :caught))))
  (testing "only the level that threw is undone"
           (is (= 2 (count-t1 *conn*)))
           (is (= [{:name "L1"} {:name "L2"}]
                  (pdo/fetch-all (pdo/query *conn* "select name from t1 order by id"))))))

(deftest nested-transaction-reports-in-transaction
  (create-t1 *conn*)
  (pdo/with-transaction *conn*
                        (is (= true (pdo/in-transaction *conn*)))
                        (pdo/with-transaction *conn*
                                              (is (= true (pdo/in-transaction *conn*))))))

(deftest savepoint-names-are-generated-and-unique
  (create-t1 *conn*)
  ;; Two sibling nested blocks in a loop must not reuse one savepoint name,
  ;; or the second RELEASE would target the first block's savepoint.
  (pdo/with-transaction *conn*
                        (dofor [i :range [0 3]]
                          (pdo/with-transaction *conn*
                                                (insert-name *conn* (str "row" i)))))
  (is (= 3 (count-t1 *conn*))))

;; -----
;; Query
;; -----

(deftest query-fetch-returns-row-as-map
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1 where id = 1")]
    (is (= {:id 1, :name "phel"} (pdo/fetch stmt)))))

(deftest fetch-returns-nil-when-no-rows
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1 where id = 999")]
    (is (nil? (pdo/fetch stmt)))))

(deftest fetch-all-returns-all-rows
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (let [stmt (pdo/query *conn* "select * from t1")]
    (is (= [{:id 1, :name "phel"} {:id 2, :name "php"}] (pdo/fetch-all stmt)))))

;; --------------------
;; Connection lifecycle
;; --------------------

(deftest close-marks-the-connection-closed
  (let [conn (pdo/connect "sqlite::memory:")]
    (is (= false (pdo/closed? conn)))
    (pdo/close conn)
    (is (= true (pdo/closed? conn)))))

(deftest close-is-idempotent
  (let [conn (pdo/connect "sqlite::memory:")]
    (pdo/close conn)
    (pdo/close conn)
    (is (= true (pdo/closed? conn)))))

(deftest using-a-closed-connection-raises-clearly
  (let [conn (pdo/connect "sqlite::memory:")]
    (pdo/close conn)
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/exec conn "select 1")))))
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/query conn "select 1")))))
    (is (php/str_contains (caught-message (fn [] (pdo/exec conn "select 1"))) "closed"))))

(deftest close-rolls-back-an-open-transaction
  (let [conn (pdo/connect "sqlite::memory:")]
    (pdo/exec conn "create table t1 (id integer primary key autoincrement, name varchar(10))")
    (pdo/begin conn)
    (pdo/insert conn :t1 {:name "phel"})
    (pdo/close conn)
    (testing "an explicit rollback beats relying on driver-specific implicit behaviour"
             (is (= true (pdo/closed? conn))))))

(deftest close-does-not-touch-a-borrowed-connection
  (let [raw  (php/new \PDO "sqlite::memory:")
        conn (pdo/from-connection raw)]
    (php/-> raw (exec "create table t1 (id integer)"))
    (pdo/close conn)
    (testing "the wrapper is unusable but the host's PDO still works"
             (is (= true (pdo/closed? conn)))
             (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/exec conn "select 1")))))
             (is (= 0 (php/-> raw (exec "insert into t1 (id) select 1 where 1 = 2")))))))

(deftest with-connection-returns-the-last-body-value
  (let [ret (pdo/with-connection [conn (pdo/connect "sqlite::memory:")]
                                 (pdo/exec conn "create table t1 (id integer)")
                                 :done)]
    (is (= :done ret))))

(deftest with-connection-closes-on-normal-return
  (let [captured (atom nil)]
    (pdo/with-connection [conn (pdo/connect "sqlite::memory:")]
                         (reset! captured conn))
    (is (= true (pdo/closed? (deref captured))))))

(deftest with-connection-closes-on-throw-and-rethrows
  (let [captured (atom nil)
        threw    (try
                   (pdo/with-connection [conn (pdo/connect "sqlite::memory:")]
                                        (reset! captured conn)
                                        (throw (php/new \Exception "boom")))
                   false
                   (catch \Exception _e true))]
    (is (= true threw))
    (is (= true (pdo/closed? (deref captured))))))

;; ------------
;; Bound columns
;; ------------

(deftest bind-column-refreshes-atoms-on-each-fetch
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (let [id   (atom nil)
        name (atom nil)
        stmt (-> (pdo/prepare *conn* "select id, name from t1 order by id")
                 (pdo/execute)
                 (pdo/bind-column 1 id)
                 (pdo/bind-column 2 name))]
    (is (= true (pdo/fetch-bound stmt)))
    (is (= [1 "phel"] [(deref id) (deref name)]))
    (is (= true (pdo/fetch-bound stmt)))
    (is (= [2 "php"] [(deref id) (deref name)]))
    (testing "exhausted cursor returns false and leaves the atoms alone"
             (is (= false (pdo/fetch-bound stmt)))
             (is (= [2 "php"] [(deref id) (deref name)])))))

(deftest bind-column-binds-by-name
  (seed-t1 *conn*)
  (let [name (atom nil)
        stmt (-> (pdo/prepare *conn* "select id, name from t1")
                 (pdo/execute)
                 (pdo/bind-column :name name))]
    (pdo/fetch-bound stmt)
    (is (= "phel" (deref name)))))

(deftest bind-column-threads-and-returns-a-statement
  (seed-t1 *conn*)
  (let [stmt (-> (pdo/prepare *conn* "select name from t1")
                 (pdo/bind-column 1 (atom nil)))]
    (is (pdo/statement? stmt))))

(deftest bind-column-leaves-the-original-statement-unbound
  (seed-t1 *conn*)
  (let [a     (atom nil)
        stmt  (-> (pdo/prepare *conn* "select name from t1") (pdo/execute))
        bound (pdo/bind-column stmt 1 a)]
    (testing "structs are immutable, so the binding lives only on the returned one"
             (is (empty? (stmt :bindings)))
             (is (= 1 (count (bound :bindings)))))))

(deftest fetch-bound-without-bindings-still-advances
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (let [stmt (-> (pdo/prepare *conn* "select name from t1") (pdo/execute))]
    (is (= true (pdo/fetch-bound stmt)))
    (is (= false (pdo/fetch-bound stmt)))))

(deftest bind-column-reads-null-as-nil
  (create-t1 *conn*)
  (pdo/exec *conn* "insert into t1 (name) values (null)")
  (let [name (atom :unset)
        stmt (-> (pdo/prepare *conn* "select name from t1")
                 (pdo/execute)
                 (pdo/bind-column 1 name))]
    (pdo/fetch-bound stmt)
    (is (nil? (deref name)))))

(deftest bind-column-rejects-an-unknown-column
  (seed-t1 *conn*)
  (let [stmt (-> (pdo/prepare *conn* "select name from t1")
                 (pdo/execute)
                 (pdo/bind-column :nope (atom nil)))]
    (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/fetch-bound stmt)))))))

;; ------------
;; IN expansion
;; ------------

;; The tokenizer is the whole difficulty here: a `?` inside a string literal, a
;; comment, or next to a Postgres `::` cast must not be treated as a placeholder.
;; Getting that wrong silently shifts every later binding by one.

(deftest expand-in-expands-a-vector-positionally
  (is (= ["select * from t1 where id in (?, ?, ?)" [1 2 3]]
         (pdo/expand-in "select * from t1 where id in (?)" [[1 2 3]]))))

(deftest expand-in-leaves-scalars-alone
  (is (= ["select * from t1 where a = ? and b = ?" [1 "x"]]
         (pdo/expand-in "select * from t1 where a = ? and b = ?" [1 "x"]))))

(deftest expand-in-mixes-scalars-and-vectors
  (is (= ["select * from t1 where id in (?, ?, ?) and status = ?" [1 2 3 "active"]]
         (pdo/expand-in "select * from t1 where id in (?) and status = ?" [[1 2 3] "active"]))))

(deftest expand-in-handles-several-vectors
  (is (= ["select * from t1 where a in (?, ?) and b in (?, ?, ?)" [1 2 3 4 5]]
         (pdo/expand-in "select * from t1 where a in (?) and b in (?)" [[1 2] [3 4 5]]))))

(deftest expand-in-expands-named-placeholders
  (is (= ["select * from t1 where id in (:ids_0, :ids_1)" {:ids_0 7, :ids_1 8}]
         (pdo/expand-in "select * from t1 where id in (:ids)" {:ids [7 8]}))))

(deftest expand-in-leaves-named-scalars-alone
  (is (= ["select * from t1 where id = :id and n = :n" {:id 1, :n 2}]
         (pdo/expand-in "select * from t1 where id = :id and n = :n" {:id 1, :n 2}))))

(deftest expand-in-ignores-placeholders-in-string-literals
  (testing "a ? inside a single-quoted literal is data, not a placeholder"
           (is (= ["select * from t1 where note = 'why?' and id in (?, ?)" [1 2]]
                  (pdo/expand-in "select * from t1 where note = 'why?' and id in (?)" [[1 2]]))))
  (testing "doubled quotes do not end the literal"
           (is (= ["select * from t1 where note = 'it''s ok? really' and id = ?" [1]]
                  (pdo/expand-in "select * from t1 where note = 'it''s ok? really' and id = ?" [1]))))
  (testing "a named placeholder inside a literal is data too"
           (is (= ["select * from t1 where note = ':id' and id = :id" {:id 1}]
                  (pdo/expand-in "select * from t1 where note = ':id' and id = :id" {:id 1})))))

(deftest expand-in-ignores-placeholders-in-comments
  (is (= ["select * from t1 -- why? :nope\nwhere id in (?, ?)" [1 2]]
         (pdo/expand-in "select * from t1 -- why? :nope\nwhere id in (?)" [[1 2]])))
  (is (= ["select /* ? :nope */ * from t1 where id = ?" [1]]
         (pdo/expand-in "select /* ? :nope */ * from t1 where id = ?" [1]))))

(deftest expand-in-ignores-quoted-identifiers
  (is (= ["select \"we?rd\" from t1 where id = ?" [1]]
         (pdo/expand-in "select \"we?rd\" from t1 where id = ?" [1])))
  (is (= ["select `we?rd` from t1 where id = ?" [1]]
         (pdo/expand-in "select `we?rd` from t1 where id = ?" [1]))))

(deftest expand-in-leaves-postgres-casts-alone
  (testing ":: is a cast operator, not a named placeholder"
           (is (= ["select id::text from t1 where id = :id" {:id 1}]
                  (pdo/expand-in "select id::text from t1 where id = :id" {:id 1})))))

(deftest expand-in-rejects-an-empty-vector
  (testing "IN () is invalid SQL on every driver; a silent IN (NULL) would look like data"
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/expand-in "select * from t1 where id in (?)" [[]])))))))

(deftest expand-in-rejects-a-param-count-mismatch
  (is (= "InvalidArgumentException"
         (caught-class (fn [] (pdo/expand-in "select * from t1 where a = ? and b = ?" [1])))))
  (is (= "InvalidArgumentException"
         (caught-class (fn [] (pdo/expand-in "select * from t1 where a = ?" [1 2])))))
  (is (= "InvalidArgumentException"
         (caught-class (fn [] (pdo/expand-in "select * from t1 where id = :missing" {:other 1}))))))

(deftest expand-in-round-trips-through-query
  (create-t1 *conn*)
  (dofor [n :in ["a" "b" "c" "d"]] (insert-name *conn* n))
  (let [[sql params] (pdo/expand-in "select name from t1 where id in (?) order by id" [[1 3]])]
    (is (= [{:name "a"} {:name "c"}] (pdo/select *conn* sql params))))
  (let [[sql params] (pdo/expand-in "select name from t1 where id in (:ids) order by id" {:ids [2 4]})]
    (is (= [{:name "b"} {:name "d"}] (pdo/select *conn* sql params)))))

;; -------------
;; CRUD builders
;; -------------

(deftest update-sets-and-returns-affected-count
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (is (= 1 (pdo/update *conn* :t1 {:name "lisp"} {:id 1})))
  (is (= [{:id 1, :name "lisp"} {:id 2, :name "php"}]
         (pdo/select *conn* "select * from t1 order by id"))))

(deftest update-affects-every-matching-row
  (create-t1 *conn*)
  (insert-name *conn* "same")
  (insert-name *conn* "same")
  (is (= 2 (pdo/update *conn* :t1 {:name "other"} {:name "same"}))))

(deftest update-handles-the-same-column-in-set-and-where
  ;; The naive builder emits :id twice for two different values.
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (is (= 1 (pdo/update *conn* :t1 {:id 99} {:id 1})))
  (is (= [{:id 99, :name "phel"}] (pdo/select *conn* "select * from t1"))))

(deftest update-binds-values-safely
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (pdo/update *conn* :t1 {:name "'; drop table t1; --"} {:id 1})
  (is (= "'; drop table t1; --" (pdo/select-value *conn* "select name from t1"))))

(deftest update-rejects-empty-set-or-where
  (create-t1 *conn*)
  (testing "an unqualified UPDATE would rewrite the whole table"
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/update *conn* :t1 {:name "x"} {})))))
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/update *conn* :t1 {} {:id 1})))))))

(deftest update-rejects-bad-identifiers
  (create-t1 *conn*)
  (is (= "InvalidArgumentException"
         (caught-class (fn [] (pdo/update *conn* "t1; drop table t1" {:name "x"} {:id 1})))))
  (is (= "InvalidArgumentException"
         (caught-class (fn [] (pdo/update *conn* :t1 {"name = 1; --" "x"} {:id 1})))))
  (is (= "InvalidArgumentException"
         (caught-class (fn [] (pdo/update *conn* :t1 {:name "x"} {"id = 1 or 1" 1}))))))

(deftest delete-removes-and-returns-affected-count
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (is (= 1 (pdo/delete *conn* :t1 {:id 1})))
  (is (= [{:id 2, :name "php"}] (pdo/select *conn* "select * from t1"))))

(deftest delete-matches-on-several-columns
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (is (= 0 (pdo/delete *conn* :t1 {:id 1, :name "nope"})))
  (is (= 1 (pdo/delete *conn* :t1 {:id 1, :name "phel"}))))

(deftest delete-rejects-empty-where
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (testing "an unqualified DELETE would empty the table"
           (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/delete *conn* :t1 {}))))))
  (is (= 1 (pdo/select-value *conn* "select count(*) from t1"))))

(deftest insert-many-inserts-every-row
  (create-t1 *conn*)
  (is (= 3 (pdo/insert-many *conn* :t1 [{:name "a"} {:name "b"} {:name "c"}])))
  (is (= [{:name "a"} {:name "b"} {:name "c"}]
         (pdo/select *conn* "select name from t1 order by id"))))

(deftest insert-many-uses-one-statement
  (create-t1 *conn*)
  ;; row-count reports the rows affected by the *last* statement. A loop of single
  ;; inserts would report 1; only one multi-VALUES statement can report 4.
  (is (= 4 (pdo/insert-many *conn* :t1 [{:name "a"} {:name "b"} {:name "c"} {:name "d"}]))))

(deftest insert-many-binds-values-safely
  (create-t1 *conn*)
  (pdo/insert-many *conn* :t1 [{:name "'; drop table t1; --"}])
  (is (= "'; drop table t1; --" (pdo/select-value *conn* "select name from t1"))))

(deftest insert-many-rejects-empty-and-mismatched-rows
  (create-t1 *conn*)
  (is (= "InvalidArgumentException" (caught-class (fn [] (pdo/insert-many *conn* :t1 [])))))
  (testing "rows without one shared column list have no single INSERT"
           (is (= "InvalidArgumentException"
                  (caught-class (fn [] (pdo/insert-many *conn* :t1 [{:name "a"} {:id 2}])))))))

(deftest insert-many-handles-multi-column-rows
  (pdo/exec *conn* "create table t2 (a, b)")
  (is (= 2 (pdo/insert-many *conn* :t2 [{:a 1, :b "x"} {:a 2, :b "y"}])))
  (is (= [{:a 1, :b "x"} {:a 2, :b "y"}] (pdo/select *conn* "select a, b from t2"))))

;; ---------------
;; One-shot reads
;; ---------------

(deftest select-returns-vector-of-maps
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (is (= [{:id 1, :name "phel"} {:id 2, :name "php"}]
         (pdo/select *conn* "select * from t1 order by id"))))

(deftest select-returns-empty-vector-for-no-rows
  (seed-t1 *conn*)
  (is (= [] (pdo/select *conn* "select * from t1 where id = ?" [999]))))

(deftest select-binds-params
  (seed-t1 *conn*)
  (is (= [{:name "phel"}] (pdo/select *conn* "select name from t1 where id = ?" [1])))
  (is (= [{:name "phel"}] (pdo/select *conn* "select name from t1 where id = :id" {:id 1}))))

(deftest select-passes-options-to-fetch-all
  (seed-t1 *conn*)
  (is (= {:cols [:id :name] :rows [[1 "phel"]]}
         (pdo/select *conn* "select id, name from t1" nil {:as :rows}))))

(deftest select-one-returns-first-row
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (is (= {:id 1, :name "phel"} (pdo/select-one *conn* "select * from t1 order by id"))))

(deftest select-one-returns-nil-for-no-rows
  (seed-t1 *conn*)
  (is (nil? (pdo/select-one *conn* "select * from t1 where id = ?" [999]))))

(deftest select-value-returns-first-column-of-first-row
  (seed-t1 *conn*)
  (is (= 1 (pdo/select-value *conn* "select count(*) from t1")))
  (is (= "phel" (pdo/select-value *conn* "select name from t1 where id = ?" [1]))))

(deftest select-value-returns-nil-for-no-rows
  (seed-t1 *conn*)
  (is (nil? (pdo/select-value *conn* "select name from t1 where id = ?" [999]))))

(deftest select-value-supports-a-not-found-sentinel
  (create-t1 *conn*)
  (pdo/exec *conn* "insert into t1 (name) values (null)")
  (testing "no row gives the sentinel; a NULL column still gives nil"
           (is (= :none (pdo/select-value *conn* "select name from t1 where id = ?" [999] :none)))
           (is (nil? (pdo/select-value *conn* "select name from t1 where id = ?" [1] :none)))))

(deftest one-shot-reads-bind-params-safely
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (dofor [f :in [pdo/select pdo/select-one pdo/select-value]]
    (f *conn* "select * from t1 where name = ?" ["'; drop table t1; --"]))
  (is (= 1 (pdo/select-value *conn* "select count(*) from t1")) "t1 must still exist"))

(deftest one-shot-reads-release-the-cursor
  ;; select-one and select-value abandon an unread cursor; on drivers with cursor
  ;; limits a leak there is a real failure mode.
  (create-t1 *conn*)
  (dofor [i :range [0 50]] (insert-name *conn* (str "n" i)))
  (dofor [_ :range [0 50]]
    (pdo/select-one *conn* "select * from t1 order by id")
    (pdo/select-value *conn* "select count(*) from t1"))
  (is (= 50 (pdo/select-value *conn* "select count(*) from t1"))))

(deftest query-without-params-is-unchanged
  (seed-t1 *conn*)
  (is (= {:id 1, :name "phel"} (pdo/fetch (pdo/query *conn* "select * from t1 where id = 1")))))

(deftest query-binds-positional-params
  (seed-t1 *conn*)
  (is (= {:id 1, :name "phel"}
         (pdo/fetch (pdo/query *conn* "select * from t1 where id = ?" [1])))))

(deftest query-binds-named-params
  (seed-t1 *conn*)
  (is (= {:id 1, :name "phel"}
         (pdo/fetch (pdo/query *conn* "select * from t1 where id = :id" {:id 1})))))

(deftest query-params-go-through-a-prepared-statement
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (testing "a hostile value is bound, never interpolated"
           (is (= [] (pdo/fetch-all (pdo/query *conn* "select * from t1 where name = ?"
                                               ["'; drop table t1; --"]))))
           (is (= 1 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1")))
               "t1 must still exist")))

(deftest query-empty-params-takes-the-no-params-path
  (seed-t1 *conn*)
  (is (= {:id 1, :name "phel"} (pdo/fetch (pdo/query *conn* "select * from t1" []))))
  (is (= {:id 1, :name "phel"} (pdo/fetch (pdo/query *conn* "select * from t1" nil)))))

(deftest query-accepts-fetch-mode-in-options
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select name from t1" nil {:fetch-mode \PDO/FETCH_NUM})]
    (is (= ["phel"] (values (php->phel (php/-> (stmt :stmt) (fetch))))))))

(deftest column-names-reports-result-set-columns
  (seed-t1 *conn*)
  (is (= [:id :name] (pdo/column-names (pdo/query *conn* "select id, name from t1"))))
  (is (= [:name :id] (pdo/column-names (pdo/query *conn* "select name, id from t1")))))

(deftest fetch-all-default-shape-is-maps
  (seed-t1 *conn*)
  (is (= (pdo/fetch-all (pdo/query *conn* "select * from t1"))
         (pdo/fetch-all (pdo/query *conn* "select * from t1") {:as :maps}))))

(deftest fetch-all-rows-shape
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (is (= {:cols [:id :name]
          :rows [[1 "phel"] [2 "php"]]}
         (pdo/fetch-all (pdo/query *conn* "select id, name from t1 order by id") {:as :rows}))))

(deftest fetch-all-rows-shape-follows-select-order
  (seed-t1 *conn*)
  (is (= {:cols [:name :id] :rows [["phel" 1]]}
         (pdo/fetch-all (pdo/query *conn* "select name, id from t1") {:as :rows}))))

(deftest fetch-all-rows-shape-keeps-cols-when-empty
  (seed-t1 *conn*)
  (is (= {:cols [:id :name] :rows []}
         (pdo/fetch-all (pdo/query *conn* "select id, name from t1 where id = 999") {:as :rows}))))

(deftest fetch-all-rows-shape-handles-nulls
  (create-t1 *conn*)
  (pdo/exec *conn* "insert into t1 (name) values (null)")
  (is (= {:cols [:id :name] :rows [[1 nil]]}
         (pdo/fetch-all (pdo/query *conn* "select id, name from t1") {:as :rows}))))

(deftest fetch-all-rejects-unknown-shape
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1")]
    (is (= "InvalidArgumentException"
           (caught-class (fn [] (pdo/fetch-all stmt {:as :php})))))
    (is (php/str_contains (caught-message (fn [] (pdo/fetch-all stmt {:as :php}))) ":maps")
        "the message should name the valid shapes")))

(deftest fetch-all-handles-null-columns
  (create-t1 *conn*)
  (pdo/exec *conn* "insert into t1 (name) values ('phel')")
  (pdo/exec *conn* "insert into t1 (name) values (null)")
  (is (= [{:id 1, :name "phel"} {:id 2, :name nil}]
         (pdo/fetch-all (pdo/query *conn* "select * from t1 order by id")))))

(deftest fetch-all-returns-empty-for-no-rows
  (seed-t1 *conn*)
  (is (= [] (pdo/fetch-all (pdo/query *conn* "select * from t1 where id = 999")))))

(deftest fetch-all-keeps-last-of-duplicate-column-names
  ;; FETCH_ASSOC collapses duplicates onto the last one; the keyword-cached path
  ;; must not diverge from that.
  (seed-t1 *conn*)
  (is (= [{:x 2}] (pdo/fetch-all (pdo/query *conn* "select 1 as x, 2 as x from t1")))))

(deftest fetch-all-preserves-column-order-and-types
  (seed-t1 *conn*)
  (is (= [{:a 1, :b "two", :c nil}]
         (pdo/fetch-all (pdo/query *conn* "select 1 as a, 'two' as b, null as c from t1")))))

(deftest statement-seq-matches-fetch-all
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (is (= (pdo/fetch-all (pdo/query *conn* "select * from t1 order by id"))
         (into [] (pdo/statement-seq (pdo/query *conn* "select * from t1 order by id"))))))

(deftest statement-seq-is-lazy
  (create-t1 *conn*)
  (dofor [i :range [0 5]] (insert-name *conn* (str "n" i)))
  (testing "take realises only what it needs and still reads correctly"
           (is (= [{:name "n0"} {:name "n1"}]
                  (->> (pdo/query *conn* "select name from t1 order by id")
                       (pdo/statement-seq)
                       (take 2)
                       (into []))))))

(deftest fetch-column-returns-nil-when-exhausted
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select name from t1 where id = 999")]
    (is (nil? (pdo/fetch-column stmt)))))

(deftest fetch-column-returns-not-found-sentinel-when-exhausted
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select name from t1 where id = 999")]
    (is (= :eof (pdo/fetch-column stmt 0 :eof)))))

(deftest fetch-column-returns-nil-for-sql-null
  (create-t1 *conn*)
  (pdo/exec *conn* "insert into t1 (name) values (null)")
  (testing "a NULL column is nil, and stays nil even when a sentinel is supplied"
           (is (nil? (pdo/fetch-column (pdo/query *conn* "select name from t1") 0)))
           (is (nil? (pdo/fetch-column (pdo/query *conn* "select name from t1") 0 :eof)))))

(deftest fetch-column-does-not-swallow-falsy-values
  ;; The old fetchColumn-based implementation could not tell PDO's false sentinel
  ;; from a real value. Every falsy column must survive the round trip.
  (is (= 0 (pdo/fetch-column (pdo/query *conn* "select 0"))))
  (is (= "" (pdo/fetch-column (pdo/query *conn* "select ''"))))
  (is (= :eof (pdo/fetch-column (pdo/query *conn* "select 0 where 1 = 2") 0 :eof))))

(deftest fetch-column-selects-by-index
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select id, name from t1")]
    (is (= 1 (pdo/fetch-column stmt 0))))
  (let [stmt (pdo/query *conn* "select id, name from t1")]
    (is (= "phel" (pdo/fetch-column stmt 1)))))

(deftest fetch-column-rejects-out-of-range-index
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select name from t1")]
    (is (= "InvalidArgumentException"
           (caught-class (fn [] (pdo/fetch-column stmt 9)))))))

(deftest fetch-column-advances-the-cursor
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (let [stmt (pdo/query *conn* "select name from t1")]
    (is (= "phel" (pdo/fetch-column stmt)))
    (is (= "php" (pdo/fetch-column stmt)))
    (is (nil? (pdo/fetch-column stmt)))))

(deftest fetch-object-returns-stdclass-row
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1 where id = 1")
        obj  (pdo/fetch-object stmt)]
    (is (= "stdClass" (php/get_class obj)))
    (is (= "phel" (php/-> obj name)))))

(deftest fetch-object-returns-nil-when-no-rows
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1 where id = 999")]
    (is (nil? (pdo/fetch-object stmt)))))

(deftest statement-seq-yields-rows-as-maps
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (let [stmt (pdo/query *conn* "select * from t1")]
    (is (= [{:id 1, :name "phel"} {:id 2, :name "php"}]
           (into [] (pdo/statement-seq stmt))))))

(deftest statement-seq-empty-result-is-empty-seq
  (create-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1")]
    (is (= [] (into [] (pdo/statement-seq stmt))))))

(deftest statement-seq-is-lazy-first-only-fetches-head
  (create-t1 *conn*)
  (insert-name *conn* "phel")
  (insert-name *conn* "php")
  (let [stmt (pdo/query *conn* "select * from t1")]
    (is (= {:id 1, :name "phel"} (first (pdo/statement-seq stmt))))))

(deftest column-count-on-select
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1")]
    (is (= 2 (pdo/column-count stmt)))))

(deftest column-meta-returns-map
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select id, name from t1")
        meta (pdo/column-meta stmt 1)]
    (is (= "name" (meta :name)))
    (is (= "t1" (meta :table)))))

(deftest row-count-on-insert
  (create-t1 *conn*)
  (let [stmt (pdo/query *conn* "insert into t1 (name) values ('phel'), ('php')")]
    (is (= 2 (pdo/row-count stmt)))))

;; ---------------
;; Prepare/execute
;; ---------------

(deftest execute-with-map-params
  (seed-t1 *conn*)
  (let [stmt (pdo/prepare *conn* "select count(*) from t1 where id = :id")
        stmt (pdo/execute stmt {:id 1})]
    (is (= 1 (pdo/fetch-column stmt)))))

(deftest bind-value
  (seed-t1 *conn*)
  (testing "inferred type"
           (let [stmt (pdo/prepare *conn* "select * from t1 where id = :id")
                 stmt (pdo/bind-value stmt :id 1)
                 stmt (pdo/execute stmt)]
             (is (= {:id 1, :name "phel"} (pdo/fetch stmt)))))
  (testing "explicit int type"
           (let [stmt (pdo/prepare *conn* "select * from t1 where id = :id")
                 stmt (pdo/bind-value stmt :id 1 \PDO/PARAM_INT)
                 stmt (pdo/execute stmt)]
             (is (= {:id 1, :name "phel"} (pdo/fetch stmt)))))
  (testing "explicit string type"
           (let [stmt (pdo/prepare *conn* "select * from t1 where name = :name")
                 stmt (pdo/bind-value stmt :name "phel" \PDO/PARAM_STR)
                 stmt (pdo/execute stmt)]
             (is (= {:id 1, :name "phel"} (pdo/fetch stmt))))))

;; PDO type constants as debug-dump-params reports them:
;; PARAM_NULL=0 PARAM_INT=1 PARAM_STR=2 PARAM_LOB=3 PARAM_BOOL=5
(defn- dumped-param-types
  "The param_type values debug-dump-params reports, in bind order."
  [stmt]
  (->> (php/explode "\n" (pdo/debug-dump-params stmt))
       (php->phel)
       (values)
       (filter (fn [line] (php/str_starts_with line "param_type=")))
       (map (fn [line] (php/intval (php/substr line 11))))
       (into [])))

(deftest bind-value-infers-param-type
  (let [stmt (pdo/prepare *conn* "select :i, :b, :n, :s, :f")]
    (pdo/bind-value stmt :i 42)
    (pdo/bind-value stmt :b true)
    (pdo/bind-value stmt :n nil)
    (pdo/bind-value stmt :s "phel")
    (pdo/bind-value stmt :f 1.5)
    (testing "int -> PARAM_INT, bool -> PARAM_BOOL, nil -> PARAM_NULL, string/float -> PARAM_STR"
             (is (= [\PDO/PARAM_INT \PDO/PARAM_BOOL \PDO/PARAM_NULL \PDO/PARAM_STR \PDO/PARAM_STR]
                    (dumped-param-types stmt))))))

(deftest query-params-infer-types
  (seed-t1 *conn*)
  (let [stmt (pdo/query *conn* "select * from t1 where id = :id" {:id 1})]
    (is (= [\PDO/PARAM_INT] (dumped-param-types stmt)))))

(deftest bind-value-explicit-type-beats-inference
  (let [stmt (pdo/prepare *conn* "select :i")]
    (pdo/bind-value stmt :i 42 \PDO/PARAM_STR)
    (is (= [\PDO/PARAM_STR] (dumped-param-types stmt)))))

(deftest bind-param-infers-param-type
  (let [stmt (pdo/prepare *conn* "select :i, :s")]
    (pdo/bind-param stmt :i 42)
    (pdo/bind-param stmt :s "phel")
    (is (= [\PDO/PARAM_INT \PDO/PARAM_STR] (dumped-param-types stmt)))))

(deftest execute-infers-param-types-for-map-params
  (let [stmt (pdo/prepare *conn* "select :i, :s, :n")]
    (pdo/execute stmt {:i 42, :s "phel", :n nil})
    (is (= [\PDO/PARAM_INT \PDO/PARAM_STR \PDO/PARAM_NULL] (dumped-param-types stmt)))))

(deftest execute-infers-param-types-for-vector-params
  (let [stmt (pdo/prepare *conn* "select ?, ?, ?")]
    (pdo/execute stmt [42 "phel" nil])
    (is (= [\PDO/PARAM_INT \PDO/PARAM_STR \PDO/PARAM_NULL] (dumped-param-types stmt)))))

(deftest execute-binds-nil-as-sql-null
  (create-t1 *conn*)
  (pdo/exec *conn* "insert into t1 (name) values ('phel')")
  (pdo/exec *conn* "insert into t1 (name) values (null)")
  (testing "a nil param matches IS NULL rather than the empty string"
           (let [stmt (pdo/prepare *conn* "select count(*) from t1 where name is :n")]
             ;; sqlite accepts `is` for NULL-safe comparison
             (is (= 1 (-> stmt (pdo/execute {:n nil}) (pdo/fetch-column)))))))

(deftest execute-under-emulated-prepares-keeps-int-params-unquoted
  ;; Emulated prepares is PDO's MySQL default. With PARAM_STR, `limit :n`
  ;; interpolates as `limit '2'`, which MySQL rejects outright.
  (let [conn (pdo/connect "sqlite::memory:" nil nil {\PDO/ATTR_EMULATE_PREPARES true})]
    (pdo/exec conn "create table t1 (id integer primary key autoincrement, name varchar(10))")
    (pdo/exec conn "insert into t1 (name) values ('a'), ('b'), ('c')")
    (let [stmt (pdo/prepare conn "select name from t1 order by id limit :n")]
      (pdo/execute stmt {:n 2})
      (is (= [\PDO/PARAM_INT] (dumped-param-types stmt)))
      (is (= [{:name "a"} {:name "b"}] (pdo/fetch-all stmt))))))

(deftest bind-param
  (seed-t1 *conn*)
  (testing "default (string) type"
           (let [stmt (pdo/prepare *conn* "select * from t1 where id = :id")
                 stmt (pdo/bind-param stmt :id 1)
                 stmt (pdo/execute stmt)]
             (is (= {:id 1, :name "phel"} (pdo/fetch stmt)))))
  (testing "explicit int type"
           (let [stmt (pdo/prepare *conn* "select * from t1 where id = :id")
                 stmt (pdo/bind-param stmt :id 1 \PDO/PARAM_INT)
                 stmt (pdo/execute stmt)]
             (is (= {:id 1, :name "phel"} (pdo/fetch stmt))))))

(deftest bind-value-by-positional-index
  (seed-t1 *conn*)
  ;; integer column is a 1-based positional placeholder, kept as an int (not "1")
  (let [stmt (pdo/prepare *conn* "select * from t1 where id = ?")
        stmt (pdo/bind-value stmt 1 1 \PDO/PARAM_INT)
        stmt (pdo/execute stmt)]
    (is (= {:id 1, :name "phel"} (pdo/fetch stmt)))))

(deftest close-cursor-allows-re-execution
  (seed-t1 *conn*)
  (let [stmt (pdo/prepare *conn* "select name from t1 where id = :id")
        stmt (pdo/execute stmt {:id 1})
        _    (pdo/fetch stmt)
        stmt (pdo/close-cursor stmt)
        stmt (pdo/execute stmt {:id 1})]
    (is (= "phel" (pdo/fetch-column stmt)))))

;; set-fetch-mode changes the statement's *native* default fetch mode. pdo/fetch
;; and pdo/fetch-all always request FETCH_ASSOC, so the only way to observe the
;; default is the raw PDOStatement::fetch - hence the (stmt :stmt) reach-through here.
(deftest set-fetch-mode-column-returns-scalar
  (seed-t1 *conn*)
  (let [stmt (pdo/prepare *conn* "select name from t1")
        stmt (pdo/set-fetch-mode stmt \PDO/FETCH_COLUMN 0)
        stmt (pdo/execute stmt)]
    (is (= "phel" (php/-> (stmt :stmt) (fetch))))))

(deftest set-fetch-mode-num-returns-positional-row
  (seed-t1 *conn*)
  (let [stmt (pdo/prepare *conn* "select id, name from t1")
        stmt (pdo/set-fetch-mode stmt \PDO/FETCH_NUM)
        stmt (pdo/execute stmt)]
    (is (= [1 "phel"] (php->phel (php/-> (stmt :stmt) (fetch)))))))

(deftest next-rowset-rejected-on-sqlite
  (seed-t1 *conn*)
  ;; SQLite has no multi-rowset support; depending on the driver build this is
  ;; either a false return or a PDOException - both prove the call reached nextRowset.
  (let [stmt    (pdo/query *conn* "select * from t1")
        outcome (try
                  (pdo/next-rowset stmt)
                  (catch \PDOException _e :unsupported))]
    (is (or (= false outcome) (= :unsupported outcome)))))

(deftest set-fetch-mode-rejects-too-many-args
  (seed-t1 *conn*)
  (let [stmt   (pdo/prepare *conn* "select * from t1")
        thrown (try
                 (pdo/set-fetch-mode stmt \PDO/FETCH_CLASS "stdClass" [] :extra)
                 false
                 (catch \InvalidArgumentException _e true))]
    (is (= true thrown))))

(deftest set-attribute-dispatches-to-statement
  (seed-t1 *conn*)
  ;; SQLite rejects statement attributes; depending on the driver build this is
  ;; either a false return or a PDOException - both prove the call reached the statement.
  (let [stmt    (pdo/prepare *conn* "select * from t1")
        outcome (try
                  (pdo/set-attribute stmt \PDO/ATTR_CURSOR \PDO/CURSOR_FWDONLY)
                  (catch \PDOException _e :unsupported))]
    (is (or (= false outcome) (= :unsupported outcome)))))

(deftest get-attribute-dispatches-to-statement
  (seed-t1 *conn*)
  (testing "connection branch still returns a value"
           (is (= \PDO/ERRMODE_EXCEPTION (pdo/get-attribute *conn* \PDO/ATTR_ERRMODE))))
  (testing "statement branch routes to the PDOStatement (SQLite reports unsupported)"
           (let [stmt  (pdo/prepare *conn* "select * from t1")
                 threw (try
                         (pdo/get-attribute stmt \PDO/ATTR_CURSOR)
                         false
                         (catch \PDOException _e true))]
             (is (= true threw)))))

(deftest debug-dump-params-emits-sql-header
  (seed-t1 *conn*)
  (let [stmt  (pdo/prepare *conn* "select * from t1 where name = :name")
        stmt  (pdo/bind-value stmt :name "phel" \PDO/PARAM_STR)
        info  (pdo/debug-dump-params stmt)
        lines (values (php->phel (php/preg_split "/\r\n|\r|\n/" info)))]
    (is (= "SQL: [35] select * from t1 where name = :name" (lines 0)))))

;; ------
;; Insert
;; ------

(deftest insert-returns-new-row-id
  (create-t1 *conn*)
  (is (= "1" (pdo/insert *conn* :t1 {:name "phel"}))))

(deftest insert-rejects-empty-row
  (create-t1 *conn*)
  (let [thrown (try
                 (pdo/insert *conn* :t1 {})
                 false
                 (catch \InvalidArgumentException _e true))]
    (is (= true thrown))))

(deftest insert-persists-row
  (create-t1 *conn*)
  (pdo/insert *conn* :t1 {:name "phel"})
  (is (= {:id 1, :name "phel"}
         (pdo/fetch (pdo/query *conn* "select * from t1 where id = 1")))))

(deftest insert-accepts-string-table
  (create-t1 *conn*)
  (is (= "1" (pdo/insert *conn* "t1" {:name "phel"}))))

(deftest insert-monotonic-ids
  (create-t1 *conn*)
  (pdo/insert *conn* :t1 {:name "a"})
  (is (= "2" (pdo/insert *conn* :t1 {:name "b"}))))

(deftest insert-rejects-bad-table
  (create-t1 *conn*)
  (let [thrown (try
                 (pdo/insert *conn* "t1; drop table t1" {:name "x"})
                 false
                 (catch \InvalidArgumentException _e true))]
    (is (= true thrown))))

(deftest insert-rejects-bad-column
  (create-t1 *conn*)
  (let [thrown (try
                 (pdo/insert *conn* :t1 {"name) --" "x"})
                 false
                 (catch \InvalidArgumentException _e true))]
    (is (= true thrown))))

(deftest insert-binds-values-safely
  (create-t1 *conn*)
  (pdo/insert *conn* :t1 {:name "'; drop table t1; --"})
  (is (= "'; drop table t1; --"
         (pdo/fetch-column (pdo/query *conn* "select name from t1 where id = 1")))))

(deftest insert-rolls-back-inside-transaction
  (create-t1 *conn*)
  (pdo/begin *conn*)
  (pdo/insert *conn* :t1 {:name "tmp"})
  (pdo/rollback *conn*)
  (is (= 0 (pdo/fetch-column (pdo/query *conn* "select count(*) from t1")))))

;; ------
;; Errors
;; ------

(deftest error-code-on-constraint-violation
  (seed-t1 *conn*)
  (try
    (pdo/exec *conn* "insert into t1 (id, name) values (1, 'php')")
    (catch \PDOException _e nil))
  (is (= "23000" (pdo/error-code *conn*))))

(deftest error-info-on-constraint-violation
  (seed-t1 *conn*)
  (try
    (pdo/exec *conn* "insert into t1 (id, name) values (1, 'php')")
    (catch \PDOException _e nil))
  (is (= ["23000" 19 "UNIQUE constraint failed: t1.id"] (pdo/error-info *conn*))))

(deftest statement-error-code-on-constraint-violation
  (seed-t1 *conn*)
  (let [stmt (pdo/prepare *conn* "insert into t1 (id, name) values (1, 'php')")]
    (try
      (pdo/execute stmt)
      (catch \PDOException _e nil))
    (is (= "23000" (pdo/error-code stmt)))))

(deftest statement-error-info-on-constraint-violation
  (seed-t1 *conn*)
  (let [stmt (pdo/prepare *conn* "insert into t1 (id, name) values (1, 'php')")]
    (try
      (pdo/execute stmt)
      (catch \PDOException _e nil))
    (is (= ["23000" 19 "UNIQUE constraint failed: t1.id"] (pdo/error-info stmt)))))
